{
  "name": "mms-server",
  "version": "1.0.0",
  "private": true,
  "description": "Manufacturing Management System - Express Backend Server",
  "type": "module",
  "scripts": {
    "dev": "tsx ../server.ts",
    "build": "esbuild ../server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=../dist/server.cjs",
    "start": "node ../dist/server.cjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.12.1",
    "pdfkit": "^0.16.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@types/pdfkit": "^0.13.9",
    "esbuild": "^0.25.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
